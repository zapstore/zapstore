    <string name="onboarding_privacy_title">Welcome to the most private app store</string>
    <string name="onboarding_privacy_body">No account needed. Your phone downloads the whole catalog in signed bundles and searches it on the device, so no server sees what you look for. Crashes are reported anonymously; you can turn that off in Settings.</string>
    <string name="onboarding_network_title">How should Zapstore connect?</string>
    <string name="onboarding_network_body">You can change this later in Settings.</string>
    <string name="onboarding_tor_title">Tor (recommended)</string>
    <string name="onboarding_tor_body">Hides your IP address from the catalog and download servers. Downloads are slower.</string>
    <string name="onboarding_direct_body">Faster. The servers see your IP address and which apps you download.</string>
    <string name="onboarding_signer_title">Connect Amber</string>
    <string name="onboarding_signer_body">Amber holds your Nostr key. Connecting restores your device key from a backup if you have one, or backs up this phone\'s key, so your saved apps and settings follow you to a new phone.</string>
    <string name="onboarding_connect_signer">Connect Amber</string>
    <string name="onboarding_get_signer_title">Want to join in?</string>
    <string name="onboarding_get_signer_body">Posting, zapping, and stacks run on Nostr, an open social network that Zapstore doesn\'t run. Amber is a separate app that holds your Nostr key and signs on your behalf \u2014 download it and sign in if you want to take part. Skip this and you can still browse and install apps with no account. A setting to turn off social features completely is coming.</string>
    <string name="onboarding_get_amber">Get Amber</string>
    <string name="onboarding_install_title">Allow installs</string>
    <string name="onboarding_install_body">Android asks once before Zapstore can install and update apps. Turn on Allow from this source, then come back.</string>
    <string name="onboarding_open_settings">Open settings</string>
    <string name="onboarding_notifications_title">Notifications</string>
    <string name="onboarding_notifications_body">Zapstore tells you when updates are ready and when an install needs your confirmation.</string>
    <string name="onboarding_allow_notifications">Allow notifications</string>
    <string name="bug_reports">Send anonymous bug reports</string>
    <string name="bug_reports_hint">Crashes and errors, encrypted to the Zapstore team and sent from a one-time key. No account, no device ID.</string>
